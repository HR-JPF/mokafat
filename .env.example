# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WhatsApp API Credentials (server-side only, never exposed to client)
# For Meta WhatsApp Cloud API or UltraMsg or Custom Webhook Bearer Token:
WHATSAPP_API_TOKEN=""
WHATSAPP_ULTRAMSG_TOKEN=""
WHATSAPP_WEBHOOK_SECRET=""

# SMTP Email Credentials (server-side only, never exposed to client)
SMTP_PASS=""

# Optional server-side super-admin override credentials (never exposed to client)
ADMIN_USERNAME=""
ADMIN_PASSCODE=""

